<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_label" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.label_print_direct</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="after">
                <app data-string="Etiket çapı" string="Etiket çapı" name="label_print_direct"
                     logo="/label_print_direct/static/description/icon.png">
                    <block title="Çap" name="alp_print_block">
                        <setting id="alp_confirm_setting" string="Böyük çapda təsdiq"
                                 help="Bir çapda bu saydan çox etiket göndəriləndə təsdiq istənir. Göndərilmiş iş printerin yaddaşından ləğv edilə bilmir. 0 = heç vaxt soruşma.">
                            <field name="alp_confirm_threshold"/>
                        </setting>
                    </block>
                    <block title="Çap agenti" name="alp_agent_block">
                        <setting id="alp_server_setting" string="Server ünvanı"
                                 help="Agentin config faylında server_url kimi yazılır.">
                            <field name="alp_server_url" readonly="1"/>
                        </setting>
                        <setting id="alp_token_setting" string="Agent tokeni"
                                 help="Agent hər sorğuda bu tokeni göndərir. Config faylına köçürün. Sızıbsa yenisini yaradın — köhnə agent dərhal dayanacaq.">
                            <field name="alp_agent_token" readonly="1"/>
                            <button name="action_alp_regenerate_token" type="object"
                                    string="Yeni token yarat" class="btn-link" icon="fa-refresh"
                                    confirm="Yeni token yaradılsın? İşləyən agentlərin config faylı yenilənməlidir."/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_alp_settings" model="ir.actions.act_window">
        <field name="name">Ayarlar</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'label_print_direct', 'bin_size': False}</field>
    </record>

</odoo>
